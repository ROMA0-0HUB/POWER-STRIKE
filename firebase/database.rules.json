{
  "rules": {
    "usernames": {
      "$name": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "users": {
      ".read": true,
      ".indexOn": ["points"],
      "$uid": { ".read": true, ".write": "auth != null && auth.uid === $uid" }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)"
      }
    },
    "roomMembers": {
      "$code": {
        ".read": "auth != null",
        "$slot": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($code).child('status').val() === 'waiting' && (root.child('rooms').child($code).child('host').val() !== auth.uid || $slot === '0')"
        }
      }
    },
    "roomInputs": {
      "$code": {
        ".read": "auth != null && auth.uid === root.child('rooms').child($code).child('host').val()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('status').val() === 'playing'"
        }
      }
    },
    "signals": {
      "$code": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null"
        }
      }
    },
    "roomStates": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === root.child('rooms').child($code).child('host').val()"
      }
    }
  }
}
